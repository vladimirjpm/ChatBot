{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "OpenAI",
    "ModelId": "gpt-4o",
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "CollectionName": "chatbot_chunks",
    "VectorSize": 1536
  },
  "Rag": {
    "ChunkSize": 512,
    "ChunkOverlap": 64,
    "TopK": 5,
    "MinScore": 0.7
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=chatbot;Username=chatbot;Password=chatbot_pass",
    "Redis": "localhost:6379"
  }
}
